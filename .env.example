# Copy this file to .env and fill in what you need.
# Everything here has a default, so the app runs without any of it.

# AI generation. Free tier from https://aistudio.google.com, no card needed.
# Leave empty to use templates instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Real Discord publishing. Channel settings, Integrations, Webhooks.
# Leave empty and the Discord adapter fails with a clear message.
DISCORD_WEBHOOK_URL=

# Database
DATABASE_URL=sqlite:///./social_studio.db

# Which adapter handles each platform.
# Set DISCORD_ADAPTER=mock_x to send discord variants to a mock instead.
DISCORD_ADAPTER=discord
X_ADAPTER=mock_x
LINKEDIN_ADAPTER=mock_linkedin

# Background worker
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30